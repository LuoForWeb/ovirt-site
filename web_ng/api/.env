#是否关闭日志,true是,false否
LOG_CLOSE = true

#错误是否发送邮件,1是,0否
SEND_ERROR_EMAIL = 0

#加解密的key和iv值
PARAM_CRYPT_KEY = 7ebec7acd38b0643c34b09c84ea54393
#最长为8 个字符串
PARAM_CRYPT_IV = sNONwyJtvi2ch2in
#接口请求时效性 单位 s
SIGN_CHECK_TIMELINESS = 600

#是否读取老框架版本的一些配置
GET_OLD_CONFIG = false

#三员模式下是否不允许修改用户密码
CHANGE_OTHER_PASSWD = true

#是否开启mock数据
MOCK_FLAG = false
MOCK_URL = http://192.168.1.28/mock/93
#验证码有效时间 单位：秒
CODE_EXPIRE_TIME = 300